// LAYER 2 - not live yet. firebase.json still deploys firestore.rules; this file only
// becomes the real one after the lineLogin Cloud Function is deployed and the employee
// page signs in with it (see LAYER2.md). Deploying it first locks every employee out.
//
// The difference from Layer 1: the LIFF page now authenticates, and its Firebase uid IS
// the LINE user id, so attendance, schedules and leave requests - which already carry
// userId - stop being world readable and become visible only to the person they belong
// to. That closes the GPS traces, leave reasons and medical certificate links.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'medlifeplus@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // The custom token minted by lineLogin uses the LINE user id as the uid, so this is
    // a direct "is this your own record?" test.
    function isSelf(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // The only user fields an employee may touch on their own document (LINE profile
    // sync and the avatar they upload) - everything else stays admin-only.
    function selfEditableUserKeys() {
      return ['pictureUrl', 'displayName', 'customPhotoURL', 'lastProfileUpdate', 'lastPhotoUploadAt'];
    }

    // 1. GLOBAL ADMIN OVERRIDE
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    // 2. USERS
    match /users/{userId} {
      // An employee reads their own record only; the directory stays admin-only, and
      // knowing a LINE user id is no longer enough to fetch somebody's profile.
      allow get: if isSelf(userId);
      allow list: if isAdmin();

      // Self registration must land as Pending - nobody approves themselves - and the
      // document id has to be the caller's own id.
      allow create: if isSelf(userId)
                    && request.resource.data.status == 'Pending'
                    && request.resource.data.lineUserId == userId;

      // Profile picture sync / avatar upload only.
      allow update: if isSelf(userId)
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(selfEditableUserKeys());

      allow delete: if isAdmin();
    }

    // 3. ATTENDANCE (clock in / clock out records, including the GPS fix)
    match /attendance/{id} {
      // Queries in the app are all scoped with where('userId','==',uid), which is what
      // lets this per-document rule satisfy a list as well as a get.
      allow read: if isSelf(resource.data.userId);

      // Only the two real record types, and no future-dated stamps. serverTimestamp()
      // evaluates to request.time, and the 23:00 auto checkout writes a past time.
      allow create: if isSelf(request.resource.data.userId)
                    && request.resource.data.type in ['เข้างาน', 'ออกงาน']
                    && request.resource.data.timestamp is timestamp
                    && request.resource.data.timestamp <= request.time;

      allow update, delete: if isAdmin();
    }

    // 4. LEAVE REQUESTS (carry the reason and the medical certificate link)
    match /leave_requests/{id} {
      allow read: if isSelf(resource.data.userId);

      // Leave has to be requested as Pending. The only self-approving type is the work
      // schedule notice, which the admin panel treats as auto-approved by design.
      allow create: if isSelf(request.resource.data.userId)
                    && (request.resource.data.status == 'Pending'
                        || (request.resource.data.status == 'Approved'
                            && request.resource.data.type == 'แจ้งเวลาปฏิบัติงาน'));

      allow update, delete: if isAdmin();
    }

    // 5. SCHEDULES (written by the admin roster and by the LIFF work schedule notice)
    match /schedules/{schedId} {
      allow read: if isSelf(resource.data.userId);

      // The document id is userId_date everywhere in the app; requiring it to match the
      // payload stops arbitrary documents being injected into the roster.
      allow create, update: if isSelf(request.resource.data.userId)
                            && request.resource.data.date is string
                            && request.resource.data.userId + '_' + request.resource.data.date == schedId;

      allow delete: if isAdmin();
    }

    // 6. SURVEY RESPONSES (one document per employee, keyed by the LINE user id)
    match /survey_responses/{userId} {
      allow create, update: if isSelf(userId)
                            && request.resource.data.userId == userId;
      allow delete: if isAdmin();
    }

    // 7. CASH SUBMISSIONS (shift cash count posted from the LIFF page)
    match /cash_submissions/{id} {
      allow create: if isSelf(request.resource.data.userId)
                    && request.resource.data.totalAmount is number;
      allow update, delete: if isAdmin();
    }

    // 8. ADMINS
    match /admins/{id} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
  }
}
